<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Iz.Application\Iz.Application.csproj" />
  </ItemGroup>

  <!--
    SÜRÜM NOTU — .NET 9'da kalıyoruz (ADR-B01). Paketlerin en yeni sürümleri
    net10.0 hedefliyor, o yüzden hepsi 9.x'e SABİTLİ.

    Microsoft.EntityFrameworkCore.Relational NİYE AÇIKÇA YAZILI?
    Npgsql sağlayıcısı 9.0.4, Relational 9.0.1'e bağlı; Design paketi ise
    9.0.19'a. MSBuild ikisini birleştiremeyip MSB3277 uyarısı üretiyordu.
    Paketi doğrudan referans vermek sürümü 9.0.19'da birleştiriyor.
    SİLME: silinirse uyarılar geri gelir. Npgsql 9.0.19'a çıktığı gün
    bu satır gereksizleşir ve kaldırılabilir.
  -->
  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.19" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.19">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.19" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

<?xml version="1.0" encoding="utf-8"?>
<!--
  YALNIZCA DEBUG DERLEMESİ İÇİN.

  NEDEN VAR?
  Android 9'dan (API 28) beri şifresiz HTTP trafiği varsayılan olarak
  ENGELLİ. Geliştirirken API'yi kendi makinemizde `http://10.0.2.2:5163`
  üzerinde çalıştırıyoruz; sertifikasız olduğu için istek daha cihazdan
  çıkmadan platform tarafından kesiliyor ve uygulamaya "ağ yok" gibi
  görünüyor.

  NEDEN `usesCleartextTraffic="true"` DEĞİL?
  O bayrak TÜM adreslere şifresiz trafiği açar ve ana manifest'te durursa
  mağazaya çıkan sürüme de sızar. Burada:
    - varsayılan kapalı (base-config),
    - yalnız üç yerel adrese izinli (domain-config),
    - ve dosya `src/debug/` altında olduğu için release derlemesine HİÇ
      girmiyor.

  10.0.2.2 = Android emülatöründen ana makinenin (host) loopback adresi.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
